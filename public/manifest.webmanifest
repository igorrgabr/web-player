{
    "name": "Web Player",
    "short_name": "Web Player",
    "description": "Web Player pessoal conectado ao Spotify Premium.",
    "start_url": "/player",
    "scope": "/",
    "display": "standalone",
    "background_color": "#09090b",
    "theme_color": "#10b981",
    "icons": [
        {
            "src": "/pwa-icon.svg",
            "sizes": "192x192 512x512 any",
            "type": "image/svg+xml",
            "purpose": "any maskable"
        },
        {
            "src": "/favicon.ico",
            "sizes": "64x64 32x32 24x24 16x16",
            "type": "image/x-icon"
        }
    ]
}
